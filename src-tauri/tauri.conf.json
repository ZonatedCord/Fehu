{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fehu",
  "version": "0.2.0",
  "identifier": "dev.fehu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Fehu",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFOEFENDU2NTIyRTRFNUIKUldSYlRpNVNWdFNLUHNuZXYybmNUcVA5TTJXMzlqM1ZqQWRkWW1yN1hReXhQQkwyd0dTVWhWNUoK",
      "endpoints": [
        "https://github.com/ZonatedCord/Fehu/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 640, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 460, "y": 190 }
      }
    }
  }
}
